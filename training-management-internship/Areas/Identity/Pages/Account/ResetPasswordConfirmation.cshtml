@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Xác nhận đặt lại mật khẩu";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-lg p-5" style="border-radius: 10px;">
                <h2 class="text-center text-success">@ViewData["Title"]</h2>
                <p class="text-center text-muted">Mật khẩu của bạn đã được đặt lại thành công.</p>
                <hr />
                <p class="text-center">
                    Vui lòng <a asp-page="./Login" class="text-primary">nhấn vào đây để đăng nhập</a>.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const card = document.querySelector(".card");
            card.classList.add("fadeIn");
        });
    </script>
}

