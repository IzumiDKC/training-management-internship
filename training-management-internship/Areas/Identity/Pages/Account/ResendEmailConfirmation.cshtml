@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Gửi lại email xác nhận";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-lg p-5" style="border-radius: 10px;">
                <h2 class="text-center text-primary">@ViewData["Title"]</h2>
                <p class="text-center text-muted">Vui lòng nhập địa chỉ email của bạn để gửi lại email xác nhận.</p>
                <hr />

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" placeholder="name@example.com" autocomplete="username" aria-required="true" />
                        <label asp-for="Input.Email" class="form-label">Địa chỉ email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <button type="submit" class="w-100 btn btn-lg btn-primary">Gửi lại email xác nhận</button>
                </form>

                <div class="text-center mt-3">
                    <p class="text-muted">Nếu bạn đã đăng ký tài khoản, vui lòng kiểm tra hộp thư email của bạn để nhận email xác nhận.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const card = document.querySelector(".card");
            card.classList.add("fadeIn");
        });
    </script>
}
