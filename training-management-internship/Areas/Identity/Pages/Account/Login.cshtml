@page
@model LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
}
<link rel="stylesheet" href="~/css/Login.css" />

<div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="row w-100 justify-content-center">
        <!-- Cột trái: Form đăng nhập -->
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-lg p-5 rounded-lg animate__animated animate__fadeInUp">
                <h2 class="text-center text-primary">@ViewData["Title"]</h2>
                <form id="account" method="post">
                    <h4 class="text-center text-muted mb-4">Sử dụng tài khoản để đăng nhập.</h4>
                    <hr />
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="mật khẩu" />
                        <label asp-for="Input.Password" class="form-label">Mật khẩu</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="checkbox mb-3">
                        <label asp-for="Input.RememberMe" class="form-label">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            Nhớ đăng nhập
                        </label>
                    </div>

                    <div>
                        <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Đăng nhập</button>
                    </div>
                    
                    <div class="text-center mt-3">
                        <p><a id="forgot-password" asp-page="./ForgotPassword" class="text-muted">Quên mật khẩu?</a></p>
                        <p><a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-muted">Đăng ký tài khoản mới</a></p>
                        <p><a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="text-muted">Gửi lại email xác nhận</a></p>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-md-6 col-lg-4 d-none d-md-block">
            <div class="card shadow-lg p-5 rounded-lg animate__animated animate__fadeInUp">
                <h3 class="text-center text-secondary">Đăng nhập qua dịch vụ khác</h3>
                <hr />
                @if ((Model.ExternalLogins?.Count ?? 0) == 0)
                {
                    <div class="text-center">
                        <p class="text-muted">
                            Không có dịch vụ xác thực bên ngoài được cấu hình.
                        </p>
                    </div>
                }
                else
                {
                    <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="form-horizontal">
                        <div class="d-flex justify-content-center">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit" class="btn btn-outline-primary mx-2" name="provider" value="@provider.Name" title="Đăng nhập bằng tài khoản @provider.DisplayName">@provider.DisplayName</button>
                            }
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
