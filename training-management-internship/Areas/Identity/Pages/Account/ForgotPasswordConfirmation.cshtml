@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Xác nhận quên mật khẩu";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm p-4 text-center">
                <h2>@ViewData["Title"]</h2>
                <p class="lead text-muted">Vui lòng kiểm tra email của bạn để đặt lại mật khẩu.</p>
                <p class="text-muted">Nếu bạn không thấy email, hãy kiểm tra thư mục spam.</p>
                <hr />
                <a href="/Account/Login" class="btn btn-secondary w-100">Quay lại đăng nhập</a>
            </div>
        </div>
    </div>
</div>
