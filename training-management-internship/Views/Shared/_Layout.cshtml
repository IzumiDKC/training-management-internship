<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - training_management_internship</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/training_management_internship.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)

</head>
<body class="@ViewData["BodyClass"]">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">training_management_internship</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="ChuongTrinhDaoTao" asp-action="Index">Chương Trình Đào Tạo</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="KhoaHoc" asp-action="Index">Khóa Học</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="DangKyKhoaHoc" asp-action="Index">ĐKKH</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Lop" asp-action="Index">Lớp</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="LoaiLop" asp-action="Index">Loại Lớp</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Admin" asp-action="Index">Admin</a>
                        </li>
                    </ul>

                </div>
            </div>
            <ul class="navbar-nav">
                @if (User.Identity.IsAuthenticated)
                {
                    <li class="nav-item">
                        <span class="nav-link text-dark">Xin chào, @User.Identity.Name!</span>
                    </li>
                    <li class="nav-item">
                        <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="form-inline">
                            <button type="submit" class="nav-link btn btn-link text-dark">Đăng xuất</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="~/Identity/Account/Login">Đăng nhập</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="~/Identity/Account/Register">Đăng ký</a>
                    </li>
                }
            </ul>


        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - training_management_internship - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
