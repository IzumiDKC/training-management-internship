@using Microsoft.AspNetCore.Identity
@using training_management_internship.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav ms-auto">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle text-white" href="#" data-bs-toggle="dropdown">
                👤 @UserManager.GetUserName(User)
            </a>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <a class="dropdown-item" href="/Identity/Account/Manage">Tài khoản</a>
                </li>
                <li>
                    <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="dropdown-item p-0">
                        <button type="submit" class="btn btn-link w-100 text-start">Đăng xuất</button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-white" href="/Identity/Account/Login">Đăng nhập</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-white" href="/Identity/Account/Register">Đăng ký</a>
        </li>
    }
</ul>

