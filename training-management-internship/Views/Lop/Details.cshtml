@model training_management_internship.Models.Lop

@{
    ViewData["Title"] = "Chi tiết lớp học";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Thông tin lớp học</h4>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Tên lớp:</strong> @Model.TenLop
                </div>
                <div class="col-md-6">
                    <strong>Khóa học:</strong> @Model.KhoaHoc?.TenKhoaHoc
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Ngày bắt đầu:</strong> @Model.NgayBatDauDuKien.ToString("dd/MM/yyyy")
                </div>
                <div class="col-md-6">
                    <strong>Ngày kết thúc:</strong> @Model.NgayKetThucDuKien.ToString("dd/MM/yyyy")
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Số giờ:</strong> @Model.SoGio
                </div>
                <div class="col-md-6">
                    <strong>Số giờ quy đổi:</strong> @Model.SoGioQuyDoi
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Loại lớp:</strong> @Model.LoaiLop?.TenLoaiLop
                </div>
                <div class="col-md-6">
                    <strong>Danh sách học viên:</strong> @(Model.CoDanhSachHocVien ? "Có" : "Không")
                </div>
            </div>
        </div>
        <div class="text-center mb-3">
            <a href="@Url.Action("ChonHocVien", "Lop", new { lopId = Model.LopId })" class="btn btn-primary">➕ Thêm học viên</a>
        </div>
    </div>

    <div class="card mt-4 shadow">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">Danh sách học viên</h4>
        </div>
        <div class="card-body">
            @if (Model.DanhSachHocViens != null && Model.DanhSachHocViens.Any())
            {
                <table class="table table-striped table-hover">
                    <thead class="thead-light">
                        <tr>
                            <th>STT</th>
                            <th>Họ tên</th>
                            <th>Số CCCD</th>
                            <th>Ngày sinh</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.DanhSachHocViens.Count; i++)
                        {
                            var hocVien = Model.DanhSachHocViens.ElementAt(i).HocVien;
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@hocVien?.User?.HoTen</td>
                                <td>@hocVien?.User?.SoCanCuoc</td>
                                <td>@hocVien?.User?.NgaySinh.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-warning">
                    <i class="fas fa-info-circle"></i> Chưa có học viên nào được thêm vào lớp này.
                </div>
            }
        </div>
    </div>
    <a asp-controller="ChiTietLop" asp-action="Index" asp-route-lopId="@Model.LopId" class="btn btn-info">
        📅 Xem buổi học
    </a>

    <div class="mt-4">
        <a asp-action="Edit" asp-route-id="@Model.LopId" class="btn btn-warning">Chỉnh sửa</a>
        <a asp-action="Index" class="btn btn-secondary ml-2">Quay lại danh sách</a>
    </div>
</div>
