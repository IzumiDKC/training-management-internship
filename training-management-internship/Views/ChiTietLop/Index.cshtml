@model IEnumerable<training_management_internship.Models.ChiTietLop>
@{
    ViewData["Title"] = "Danh sách buổi học";
    var lop = ViewBag.Lop as training_management_internship.Models.Lop;
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">📚 Danh sách buổi học @if (lop != null)
                {
                    <span>- @lop.TenLop</span>
                }</h4>
            @if (lop != null)
            {
                <a asp-action="Create" asp-route-lopId="@lop.LopId" class="btn btn-light btn-sm">
                    ➕ Thêm buổi học
                </a>
            }
        </div>

        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="alert alert-warning">
                    <i class="fas fa-info-circle"></i> Chưa có buổi học nào được tạo cho lớp này.
                </div>
            }
            else
            {
                <table class="table table-striped table-bordered">
                    <thead class="thead-dark">
                        <tr>
                            <th>STT</th>
                            <th>Ngày học</th>
                            <th>Bắt đầu</th>
                            <th>Kết thúc</th>
                            <th>Giảng viên</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count(); i++)
                        {
                            var item = Model.ElementAt(i);
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@item.NgayHoc.ToString("dd/MM/yyyy")</td>
                                <td>@item.ThoiGianBatDau.ToString(@"hh\:mm")</td>
                                <td>@item.ThoiGianKetThuc.ToString(@"hh\:mm")</td>
                                <td>@item.GiangVien?.User?.HoTen</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.ChiTietLopId" class="btn btn-sm btn-warning">✏️ Sửa</a>
                                    <a asp-action="Details" asp-route-id="@item.ChiTietLopId" class="btn btn-sm btn-info">🔍 Xem</a>
                                    <a asp-action="Delete" asp-route-id="@item.ChiTietLopId" class="btn btn-sm btn-danger" onclick="return confirm('Xóa buổi học này?');">🗑️ Xóa</a>
                                    <a asp-controller="DiemDanh"
                                       asp-action="DiemDanh"
                                       asp-route-chiTietLopId="@item.ChiTietLopId"
                                       class="btn btn-sm btn-success mt-1">
                                        📋 Điểm danh
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Lop" asp-action="Details" asp-route-id="@lop?.LopId" class="btn btn-secondary">
            ⬅️ Quay về chi tiết lớp
        </a>
    </div>
</div>
