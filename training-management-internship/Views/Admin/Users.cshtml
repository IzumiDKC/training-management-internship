@model List<training_management_internship.Models.ApplicationUser>
@{
    ViewData["Title"] = "Quản lý người dùng";
    var currentRole = ViewData["CurrentRoleFilter"]?.ToString();
    var currentSearch = ViewData["CurrentSearchName"]?.ToString();
    var userRoles = ViewData["UserRoles"] as Dictionary<string, string>;
}

<div class="container mt-4">
    <h2 class="mb-4 text-primary">📋 Quản lý người dùng</h2>

    <form asp-action="DeleteAll" method="post" onsubmit="return confirm('Bạn chắc chắn muốn xóa toàn bộ người dùng?');">
        <button type="submit" class="btn btn-danger mb-3">🗑️ Xóa tất cả người dùng</button>
    </form>

    <form method="get" class="form-inline mb-4 p-3 border rounded bg-light shadow-sm">
        <div class="form-group mr-3">
            <label class="font-weight-bold mr-2">Lọc theo vai trò:</label>
            <select name="roleFilter" class="form-control">
                <option value="">-- Tất cả --</option>
                <option value="HocVien" selected="@(currentRole == "HocVien")">Học viên</option>
                <option value="GiangVien" selected="@(currentRole == "GiangVien")">Giảng viên</option>
                <option value="Admin" selected="@(currentRole == "Admin")">Admin</option>
            </select>
        </div>

        <div class="form-group mr-3">
            <label class="font-weight-bold mr-2">Tìm theo tên:</label>
            <input type="text" name="searchName" class="form-control" value="@currentSearch" placeholder="Nhập họ tên..." />
        </div>

        <button type="submit" class="btn btn-primary">🔍 Lọc</button>
        <a asp-action="Users" class="btn btn-secondary ml-2">🔄 Đặt lại</a>
    </form>

    <table class="table table-bordered table-hover shadow-sm">
        <thead class="thead-dark">
            <tr>
                <th>#</th>
                <th>Họ tên</th>
                <th>Số CCCD</th>
                <th>Ngày sinh</th>
                <th>Vai trò</th>
                <th>Thông tin thêm</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                int index = 1;
                foreach (var user in Model)
                {
                    string roleName = userRoles != null && userRoles.TryGetValue(user.Id, out var foundRole)
                    ? foundRole
                    : "Khác";
                    <tr>
                        <td>@(index++)</td>
                        <td>@user.HoTen</td>
                        <td>@user.SoCanCuoc</td>
                        <td>@user.NgaySinh.ToString("dd/MM/yyyy")</td>
                        <td>
                            @switch (roleName)
                            {
                                case "Admin":
                                    <span class="badge bg-dark text-white">Admin</span>
                                    break;
                                case "GiangVien":
                                    <span class="badge bg-success text-white">Giảng viên</span>
                                    break;
                                case "HocVien":
                                    <span class="badge bg-primary text-white">Học viên</span>
                                    break;
                                default:
                                    <span class="badge bg-warning text-dark">Khác</span>
                                    break;
                            }
                        </td>
                        <td>
                            @if (roleName == "Admin")
                            {
                                <em>Tài khoản quản trị</em>
                            }
                            else if (user.GiangVien != null)
                            {
                                <div><strong>ID:</strong> @user.GiangVien.GiangVienId</div>
                            }
                            else if (user.HocVien != null)
                            {
                                <div><strong>Tổng khóa học:</strong> @user.HocVien.TongKhoaHoc</div>
                            }
                            else
                            {
                                <em>Không có dữ liệu</em>
                            }
                        </td>
                        <td>
                            @if (roleName == "HocVien" || roleName == "GiangVien")
                            {
                                <a asp-action="ChangeRole" asp-route-userId="@user.Id" class="btn btn-sm btn-outline-warning">
                                    🔁 Chuyển vai trò
                                </a>
                            }
                        </td>

                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">Không có người dùng nào phù hợp.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
